    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "idb": "^8.0.0",
    "ifvms": "^1.1.6",
    "svelte-i18n": "^4.0.1"
  }
